<main class="page-shell">
  <section class="hero">
    <p class="eyebrow"><%= t("forecasts.index.app_name") %></p>
    <h1><%= t("forecasts.index.title") %></h1>
    <p class="hero-copy"><%= t("forecasts.index.description") %></p>
  </section>

  <section class="lookup-panel">
    <% if flash[:alert].present? %>
      <div class="flash flash-alert"><%= flash[:alert] %></div>
    <% end %>

    <% if flash[:notice].present? %>
      <div class="flash flash-notice"><%= flash[:notice] %></div>
    <% end %>

    <%= form_with scope: :forecast,
        url: forecasts_path,
        method: :get,
        class: "forecast-form",
        data: {
          turbo: false,
          controller: "forecast-form",
          action: "submit->forecast-form#submit",
          "forecast-form-loading-text-value": t("forecasts.index.form.loading_button")
        } do |form| %>
      <div class="field">
        <%= form.label :address, t("forecasts.index.form.address_label") %>
        <%= form.text_field :address,
            value: @address,
            placeholder: t("forecasts.index.form.address_placeholder"),
            autocomplete: "street-address",
            class: "text-input" %>
      </div>

      <%= form.submit t("forecasts.index.form.submit"),
          class: "submit-button",
          data: { forecast_form_target: "submitButton" } %>

      <p class="form-status" data-forecast-form-target="status" hidden>
        <%= t("forecasts.index.form.loading_status") %>
      </p>
    <% end %>
  </section>

  <% if @location.present? %>
    <section class="result-panel">
      <div class="result-header">
        <p class="eyebrow"><%= t("forecasts.index.location.eyebrow") %></p>
        <h2><%= @location.formatted_address %></h2>
      </div>

      <dl class="result-grid">
        <div>
          <dt><%= t("forecasts.index.location.zip_code") %></dt>
          <dd><%= @location.zip_code %></dd>
        </div>

        <div>
          <dt><%= t("forecasts.index.location.latitude") %></dt>
          <dd><%= @location.latitude %></dd>
        </div>

        <div>
          <dt><%= t("forecasts.index.location.longitude") %></dt>
          <dd><%= @location.longitude %></dd>
        </div>
      </dl>
    </section>
  <% end %>

  <% if @current_forecast.present? %>
    <section class="weather-panel">
      <div class="weather-panel-header">
        <div class="panel-meta">
          <p class="eyebrow"><%= t("forecasts.index.forecast.eyebrow") %></p>
          <% if @cache_hit %>
            <span class="cache-badge"><%= t("forecasts.index.forecast.cache_hit") %></span>
          <% else %>
            <span class="cache-badge"><%= t("forecasts.index.forecast.live_lookup") %></span>
          <% end %>
        </div>
        <h2><%= @current_forecast.condition_label %></h2>
      </div>

      <div class="temperature-strip">
        <div class="temperature-pill">
          <span class="temperature-value"><%= @current_forecast.temperature %></span>
          <span class="temperature-unit"><%= @current_forecast.temperature_unit %></span>
        </div>
      </div>

      <dl class="result-grid">
        <div>
          <dt><%= t("forecasts.index.forecast.zip_source") %></dt>
          <dd><%= @location.zip_code %></dd>
        </div>

        <div>
          <dt><%= t("forecasts.index.forecast.high_low") %></dt>
          <dd>
            <%= @current_forecast.daily_high %><%= @current_forecast.temperature_unit %>
            /
            <%= @current_forecast.daily_low %><%= @current_forecast.temperature_unit %>
          </dd>
        </div>

        <div>
          <dt><%= t("forecasts.index.forecast.feels_like") %></dt>
          <dd><%= @current_forecast.apparent_temperature %><%= @current_forecast.temperature_unit %></dd>
        </div>

        <div>
          <dt><%= t("forecasts.index.forecast.observed_at") %></dt>
          <dd><%= @current_forecast.fetched_at %></dd>
        </div>

        <div>
          <dt><%= t("forecasts.index.forecast.wind_speed") %></dt>
          <dd><%= @current_forecast.wind_speed %> <%= @current_forecast.wind_speed_unit %></dd>
        </div>
      </dl>
    </section>

    <section class="extended-panel">
      <div class="result-header">
        <p class="eyebrow"><%= t("forecasts.index.extended.eyebrow") %></p>
        <h2><%= t("forecasts.index.extended.title") %></h2>
      </div>

      <div class="forecast-list">
        <% @current_forecast.daily_periods.each do |period| %>
          <article class="forecast-day">
            <p class="forecast-day-date"><%= period.date %></p>
            <p class="forecast-day-condition"><%= period.condition_label %></p>
            <p class="forecast-day-temps">
              <strong><%= period.high %><%= @current_forecast.temperature_unit %></strong>
              <span><%= period.low %><%= @current_forecast.temperature_unit %></span>
            </p>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>
</main>
