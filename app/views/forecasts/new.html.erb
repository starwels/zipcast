<main class="page-shell">
  <section class="hero">
    <p class="eyebrow">ZipCast</p>
    <h1>Weather lookup by address</h1>
    <p class="hero-copy">
      Enter a street address and get the current forecast for the resolved ZIP
      code, with caching and an indicator when the result comes from cache.
    </p>
  </section>

  <section class="lookup-panel">
    <% if flash[:alert].present? %>
      <div class="flash flash-alert"><%= flash[:alert] %></div>
    <% end %>

    <% if flash[:notice].present? %>
      <div class="flash flash-notice"><%= flash[:notice] %></div>
    <% end %>

    <%= form_with scope: :forecast, url: forecasts_path, method: :post, class: "forecast-form" do |form| %>
      <div class="field">
        <%= form.label :address, "Address" %>
        <%= form.text_field :address,
            value: @address,
            placeholder: "1600 Amphitheatre Parkway, Mountain View, CA",
            autocomplete: "street-address",
            class: "text-input" %>
      </div>

      <%= form.submit "Look up forecast", class: "submit-button" %>
    <% end %>
  </section>

  <% if @location.present? %>
    <section class="result-panel">
      <div class="result-header">
        <p class="eyebrow">Resolved Location</p>
        <h2><%= @location.formatted_address %></h2>
      </div>

      <dl class="result-grid">
        <div>
          <dt>ZIP code</dt>
          <dd><%= @location.zip_code %></dd>
        </div>

        <div>
          <dt>Latitude</dt>
          <dd><%= @location.latitude %></dd>
        </div>

        <div>
          <dt>Longitude</dt>
          <dd><%= @location.longitude %></dd>
        </div>
      </dl>
    </section>
  <% end %>

  <% if @current_forecast.present? %>
    <section class="weather-panel">
      <div class="weather-panel-header">
        <div class="panel-meta">
          <p class="eyebrow">Current Forecast</p>
          <% if @cache_hit %>
            <span class="cache-badge">From cache</span>
          <% else %>
            <span class="cache-badge cache-badge-live">Live lookup</span>
          <% end %>
        </div>
        <h2><%= @current_forecast.condition_label %></h2>
      </div>

      <div class="temperature-strip">
        <div class="temperature-pill">
          <span class="temperature-value"><%= @current_forecast.temperature %></span>
          <span class="temperature-unit"><%= @current_forecast.temperature_unit %></span>
        </div>
      </div>

      <dl class="result-grid">
        <div>
          <dt>ZIP source</dt>
          <dd><%= @location.zip_code %></dd>
        </div>

        <div>
          <dt>Feels like</dt>
          <dd><%= @current_forecast.apparent_temperature %><%= @current_forecast.temperature_unit %></dd>
        </div>

        <div>
          <dt>Observed at</dt>
          <dd><%= @current_forecast.fetched_at %></dd>
        </div>

        <div>
          <dt>Wind speed</dt>
          <dd><%= @current_forecast.wind_speed %> <%= @current_forecast.wind_speed_unit %></dd>
        </div>
      </dl>
    </section>
  <% end %>
</main>
